      "formResponse": {
        "type": "com.krista.net.model.form.FormResponse",
        "fieldValues": {
          "FIELD_bfd0575e-4320-4d90-9519-c026b705db42": [
            "Maya wandered through the abandoned train station, her flashlight flickering. She had heard rumors of a hidden journal left by her grandfather, who vanished here decades ago. Dust covered the benches, and echoes of old announcements bounced off the cracked walls.",
            "Behind a loose tile near the ticket booth, she found a small metal box. Inside was the journal, wrapped in faded cloth. Its pages were brittle, filled with sketches, maps, and notes about a secret project called \"Echo Line.\" One phrase stood out: \"Find the pulse beneath the tracks.\"",
            "Following the journal's clues, Maya descended into a forgotten tunnel. At its heart, she found a humming machine still pulsing with life. As she touched it, memories not her own flooded her mind. Her grandfather hadn't vanished—he had crossed into something beyond time."
          ],
          "FIELD_321fcfdb-118b-4645-87ec-6a023b0a0676": 0.05,
          "FIELD_5850372e-5b29-4153-8f1f-3e17f7c3353f": 20
        },
